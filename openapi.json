{
  "openapi": "3.1.0",
  "info": {
    "title": "InboxReady API",
    "summary": "Developer-first email domain readiness checks.",
    "description": "Audit email authentication posture for customer-owned domains. Checks MX, SPF, DMARC, DKIM, MTA-STS, TLS-RPT, and BIMI with optional API keys, rate limiting, result caching, compare, and markdown reports.",
    "version": "0.5.0"
  },
