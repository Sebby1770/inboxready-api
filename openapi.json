  "components": {
    "schemas": {
      "AuditCheck": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "pass",
              "warn",
              "fail",
              "info"
            ],
            "title": "Status"
          },
          "summary": {
            "type": "string",
            "title": "Summary"
          },
          "details": {
            "additionalProperties": true,
            "type": "object",
            "title": "Details"
          }
        },
        "type": "object",
        "required": [
          "status",
          "summary"
        ],
        "title": "AuditCheck"
      },
      "BatchAuditRequest": {
        "properties": {
          "domains": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 25,
            "minItems": 1,
            "title": "Domains",
            "description": "Root domains to inspect. Duplicate normalized domains are audited once."
          },
          "selectors": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Selectors",
            "description": "Optional DKIM selectors to test across every domain."
          },
          "expected_providers": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Expected Providers",
            "description": "Optional provider names expected across every domain."
          }
        },
        "type": "object",
        "required": [
          "domains"
        ],
        "title": "BatchAuditRequest"
      },
      "BatchAuditResponse": {
        "properties": {
          "audits": {
            "items": {
              "$ref": "#/components/schemas/DomainAuditResponse"
            },
            "type": "array",
            "title": "Audits"
          },
          "summary": {
            "$ref": "#/components/schemas/BatchAuditSummary"
          }
        },
        "type": "object",
        "required": [
          "audits",
          "summary"
        ],
        "title": "BatchAuditResponse"
      },
      "BatchAuditSummary": {
        "properties": {
          "domain_count": {
            "type": "integer",
            "title": "Domain Count"
          },
          "average_score": {
            "type": "number",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Average Score"
          },
          "status_counts": {
            "additionalProperties": {
              "type": "integer"
            },
            "type": "object",
            "title": "Status Counts"
          },
          "priority_recommendations": {
            "items": {
              "$ref": "#/components/schemas/RecommendationTrend"
            },
            "type": "array",
            "title": "Priority Recommendations"
          }
        },
        "type": "object",
        "required": [
          "domain_count",
          "average_score",
          "status_counts"
        ],
        "title": "BatchAuditSummary"
      },
      "CacheClearResponse": {
        "properties": {
          "cleared": {
            "type": "integer",
            "title": "Cleared"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "cleared",
          "message"
        ],
        "title": "CacheClearResponse"
      },
      "CompareCheckDiff": {
        "properties": {
          "check": {
            "type": "string",
            "title": "Check"
          },
          "statuses": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Statuses"
          },
          "summaries": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Summaries"
          },
          "differs": {
            "type": "boolean",
            "title": "Differs"
          }
        },
        "type": "object",
        "required": [
          "check",
          "statuses",
          "summaries",
          "differs"
        ],
        "title": "CompareCheckDiff"
      },
      "CompareRequest": {
        "properties": {
          "domains": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 10,
            "minItems": 2,
            "title": "Domains",
            "description": "Domains to compare side-by-side (2\u201310 unique after normalization)."
          },
          "selectors": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Selectors"
          },
          "expected_providers": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Expected Providers"
          }
        },
        "type": "object",
        "required": [
          "domains"
        ],
        "title": "CompareRequest"
      },
      "CompareResponse": {
        "properties": {
          "domains": {
            "items": {
              "$ref": "#/components/schemas/DomainScoreSummary"
            },
            "type": "array",
            "title": "Domains"
          },
          "check_diffs": {
            "items": {
              "$ref": "#/components/schemas/CompareCheckDiff"
            },
            "type": "array",
            "title": "Check Diffs"
          },
          "audits": {
            "items": {
              "$ref": "#/components/schemas/DomainAuditResponse"
            },
            "type": "array",
            "title": "Audits"
          }
        },
        "type": "object",
        "required": [
          "domains",
          "check_diffs"
        ],
        "title": "CompareResponse"
      },
      "DomainAuditRequest": {
        "properties": {
          "domain": {
            "type": "string",
            "title": "Domain",
            "description": "The root domain to inspect."
          },
          "selectors": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Selectors",
            "description": "Optional DKIM selectors to test explicitly."
          },
          "expected_providers": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Expected Providers",
            "description": "Optional provider names expected for this domain."
          }
        },
        "type": "object",
        "required": [
          "domain"
        ],
        "title": "DomainAuditRequest"
      },
      "DomainAuditResponse": {
        "properties": {
          "domain": {
            "type": "string",
            "title": "Domain"
          },
          "score": {
            "type": "integer",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Score"
          },
          "overall_status": {
            "type": "string",
            "enum": [
              "pass",
              "warn",
              "fail",
              "info"
            ],
            "title": "Overall Status"
          },
          "checked_at": {
            "type": "string",
            "title": "Checked At"
          },
          "providers": {
            "items": {
              "$ref": "#/components/schemas/ProviderMatch"
            },
            "type": "array",
            "title": "Providers"
          },
          "checks": {
            "additionalProperties": {
              "$ref": "#/components/schemas/AuditCheck"
            },
            "type": "object",
            "title": "Checks"
          },
          "recommendations": {
            "items": {
              "$ref": "#/components/schemas/Recommendation"
            },
            "type": "array",
            "title": "Recommendations"
          },
          "references": {
            "items": {
              "type": "string",
              "maxLength": 2083,
              "minLength": 1,
              "format": "uri"
            },
            "type": "array",
            "title": "References"
          }
        },
        "type": "object",
        "required": [
          "domain",
          "score",
          "overall_status",
          "checked_at",
          "checks"
        ],
        "title": "DomainAuditResponse"
      },
      "DomainScoreSummary": {
        "properties": {
          "domain": {
            "type": "string",
            "title": "Domain"
          },
          "score": {
            "type": "integer",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Score"
          },
          "overall_status": {
            "type": "string",
            "enum": [
              "pass",
              "warn",
              "fail",
              "info"
            ],
            "title": "Overall Status"
          }
        },
        "type": "object",
        "required": [
          "domain",
          "score",
          "overall_status"
        ],
        "title": "DomainScoreSummary"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ProviderCatalogResponse": {
        "properties": {
          "providers": {
            "items": {
              "$ref": "#/components/schemas/ProviderMatch"
            },
            "type": "array",
            "title": "Providers"
          }
        },
        "type": "object",
        "required": [
          "providers"
        ],
        "title": "ProviderCatalogResponse"
      },
      "ProviderMatch": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "confidence": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Confidence"
          },
          "evidence": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Evidence"
          },
          "suggested_selectors": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Suggested Selectors"
          }
        },
        "type": "object",
        "required": [
          "name",
          "confidence"
        ],
        "title": "ProviderMatch"
      },
      "Recommendation": {
        "properties": {
          "severity": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high"
            ],
            "title": "Severity"
          },
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "details": {
            "anyOf": [
              {
                "type": "string"
              },
              {
