# HTTP client used for MTA-STS policy fetch
INBOXREADY_HTTP_TIMEOUT_SECONDS=5.0
INBOXREADY_USER_AGENT=InboxReady/0.7 (+https://example.com)

# Comma-separated API keys. When non-empty, X-API-Key is required on /v1/* routes.
# Leave empty for an open local/demo deployment.
INBOXREADY_API_KEYS=

# Force API key requirement even when INBOXREADY_API_KEYS is empty.
INBOXREADY_REQUIRE_API_KEY=false

# Sliding-window rate limit per API key (or client IP when unauthenticated).
# Set to 0 to disable.
INBOXREADY_RATE_LIMIT_PER_MINUTE=60

# Bound client churn so forged/rotating addresses cannot grow process memory forever.
INBOXREADY_RATE_LIMIT_MAX_BUCKETS=20000

# In-memory TTL cache for domain audit results (seconds). 0 disables caching.
INBOXREADY_CACHE_TTL_SECONDS=300
INBOXREADY_CACHE_MAX_ENTRIES=2000

# Default body limit for JSON and forms. DMARC multipart uploads have a larger
# envelope limit because their decoded payloads are separately bounded too.
INBOXREADY_REQUEST_BODY_MAX_BYTES=1048576
INBOXREADY_REPORT_UPLOAD_BODY_MAX_BYTES=37748736

# Thread pool size for concurrent batch domain audits.
INBOXREADY_BATCH_MAX_WORKERS=8

# v0.3
INBOXREADY_HISTORY_MAX_ENTRIES=500
INBOXREADY_HISTORY_PATH=
INBOXREADY_WEBHOOK_URL=
INBOXREADY_WEBHOOK_MIN_SCORE=70
INBOXREADY_WEBHOOK_SECRET=
INBOXREADY_WEBHOOK_MAX_ATTEMPTS=3
INBOXREADY_WEBHOOK_TIMEOUT_SECONDS=3.0
# Leave false for internet receivers. Enable only for an intentional internal target.
INBOXREADY_WEBHOOK_ALLOW_PRIVATE_HOSTS=false

# Forwarded client addresses are ignored unless the direct peer is listed here.
# Example: 10.0.0.0/8,192.0.2.10/32
INBOXREADY_TRUSTED_PROXY_CIDRS=

# Emits JSON request events with request ID, path, status, duration, and a
# one-way client hash. Headers, query strings, and bodies are never logged.
INBOXREADY_ACCESS_LOG_ENABLED=true

# --- v0.5: site & growth surface ------------------------------------------

# Deployment environment. Only "production" is crawlable: any other value makes
# robots.txt a blanket disallow and marks every page noindex, so a staging copy
# can never compete with the real site in search results.
INBOXREADY_ENVIRONMENT=development

# Absolute public origin, e.g. https://inboxready.dev. Drives canonical URLs,
# sitemap entries, and the absolute og:image URL. Falls back to the request
# origin when empty, which is fine locally and wrong behind a proxy.
INBOXREADY_SITE_BASE_URL=

# Google Analytics 4 measurement ID (G-XXXXXXXXXX). Empty means no analytics
# script is served at all and the CSP stays script-src 'self'.
INBOXREADY_ANALYTICS_GA4_ID=

# Withhold analytics until the visitor accepts the consent banner.
INBOXREADY_ANALYTICS_REQUIRE_CONSENT=true

# Published first-response promise, in hours. Rendered as "We reply within N".
INBOXREADY_SUPPORT_RESPONSE_HOURS=24

# Optional JSON file for contact form submissions. Empty keeps them in memory.
INBOXREADY_LEADS_PATH=
INBOXREADY_LEADS_MAX_ENTRIES=500

# CSP, nosniff, Referrer-Policy, Permissions-Policy, and HSTS on HTML responses.
INBOXREADY_SECURITY_HEADERS_ENABLED=true
